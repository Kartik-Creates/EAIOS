# Environment Mode
ENVIRONMENT=development

# Server Config
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_USER=eaios_user
POSTGRES_PASSWORD=eaios_password_placeholder
POSTGRES_DB=eaios_db
DATABASE_URL=postgresql+asyncpg://eaios_user:eaios_password_placeholder@localhost:5432/eaios_db

# Redis Cache & Queue
REDIS_URL=redis://localhost:6379/0

# Ollama Embeddings (local; use http://ollama:11434 when running via docker-compose)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Security (JWT)
SECRET_KEY=generate_strong_secret_key_min_32_chars_placeholder
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Integration OAuth Placeholders (To be configured per teammate)
GMAIL_CLIENT_ID=your_gmail_client_id_placeholder
GMAIL_CLIENT_SECRET=your_gmail_client_secret_placeholder

SLACK_BOT_TOKEN=xoxb-your_slack_bot_token_placeholder
SLACK_SIGNING_SECRET=your_slack_signing_secret_placeholder

DRIVE_CLIENT_ID=your_drive_client_id_placeholder
DRIVE_CLIENT_SECRET=your_drive_client_secret_placeholder

GITHUB_CLIENT_ID=your_github_client_id_placeholder
GITHUB_CLIENT_SECRET=your_github_client_secret_placeholder

JIRA_API_TOKEN=your_jira_api_token_placeholder
JIRA_DOMAIN=your-domain.atlassian.net
