# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://eaios_user:eaios_password_placeholder@localhost:5432/eaios_db

# Host URLs for OAuth Redirects & CORS
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Redis Cache & Queue

REDIS_URL=redis://localhost:6379/0

# LLM & Embedding Provider Selection
# LLM_PROVIDER=ollama for local development (uses OLLAMA_BASE_URL and OLLAMA_CHAT_MODEL below)
# LLM_PROVIDER=gemini for production deployment (uses GEMINI_API_KEY and GEMINI_MODEL)
LLM_PROVIDER=ollama
GEMINI_API_KEY=your_gemini_api_key_placeholder
GEMINI_MODEL=gemini-2.0-flash


# EMBEDDING_PROVIDER=ollama for local development (uses OLLAMA_EMBED_MODEL, default nomic-embed-text)
# EMBEDDING_PROVIDER=gemini for production deployment (uses Gemini text-embedding-004, 768-dim — same dim as nomic)
# IMPORTANT: Switching providers requires running the re-embedding migration:
#   python -m scripts.reembed_documents --run    # re-embed all chunks
#   python -m scripts.reembed_documents --swap   # swap staging -> live
EMBEDDING_PROVIDER=ollama


# Ollama (local; use http://ollama:11434 when running via docker-compose)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2

# Chat endpoint rate limit
CHAT_RATE_LIMIT=10/minute


# Security (JWT)
SECRET_KEY=generate_strong_secret_key_min_32_chars_placeholder
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth token-at-rest encryption (AES-256-GCM)
ENCRYPTION_KEY=generate_strong_encryption_key_min_32_chars_placeholder

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_placeholder
GOOGLE_CLIENT_SECRET=your_google_client_secret_placeholder

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id_placeholder
GITHUB_CLIENT_SECRET=your_github_client_secret_placeholder

# Slack OAuth/Token
SLACK_CLIENT_ID=your_slack_client_id_placeholder
SLACK_CLIENT_SECRET=your_slack_client_secret_placeholder
SLACK_BOT_TOKEN=xoxb-your_slack_bot_token_placeholder

# Jira OAuth/Token
JIRA_CLIENT_ID=your_jira_client_id_placeholder
JIRA_CLIENT_SECRET=your_jira_client_secret_placeholder
JIRA_API_TOKEN=your_jira_api_token_placeholder
